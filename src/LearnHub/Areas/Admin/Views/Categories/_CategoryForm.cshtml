@model CategoryFormViewModel
<div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

<div class="form-panel">
    <div class="mb-3">
        <label asp-for="Name" class="form-label"></label>
        <input asp-for="Name" class="form-control" data-char-counter />
        <span asp-validation-for="Name"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description" class="form-control" rows="3" data-char-counter></textarea>
        <span asp-validation-for="Description"></span>
    </div>

    <fieldset>
        <legend class="form-label">Icon</legend>
        <div class="icon-picker">
            @foreach (var icon in CategoryIcons.Allowed)
            {
                var inputId = "icon-" + icon.Key;
                <div>
                    <input type="radio" id="@inputId" name="@nameof(CategoryFormViewModel.IconName)" value="@icon.Key" checked="@(icon.Key == Model.IconName)" />
                    <label for="@inputId"><i class="@("bi bi-" + icon.Key)" aria-hidden="true"></i>@icon.Value</label>
                </div>
            }
        </div>
        <span asp-validation-for="IconName"></span>
    </fieldset>
</div>
