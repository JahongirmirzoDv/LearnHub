@model CategoryDeleteViewModel
@{
    ViewData["Title"] = $"Delete {Model.Name}";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>Delete category</h1>
        <p>@Model.Name</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-7">
        @if (Model.CourseCount > 0)
        {
            <div class="danger-panel">
                <h2><i class="bi bi-lock me-2" aria-hidden="true"></i>This category can't be deleted yet</h2>
                <p>
                    “@Model.Name” still contains @DisplayFormat.Plural(Model.CourseCount, "course").
                    Categories that contain courses are protected so courses are never deleted by accident.
                    Move those courses to another category, or delete them, first.
                </p>
                <div class="form-actions">
                    <a class="btn btn-primary" asp-controller="Courses" asp-action="Index" asp-route-categoryId="@Model.Id">View courses in this category</a>
                    <a class="btn btn-outline-primary" asp-action="Index">Back to categories</a>
                </div>
            </div>
        }
        else
        {
            <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="danger-panel">
                <h2>Delete “@Model.Name”?</h2>
                <p>The category is empty, so no courses are affected. This can't be undone.</p>
                <div class="form-actions">
                    <button type="submit" class="btn btn-danger">Delete category</button>
                    <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
                </div>
            </form>
        }
    </div>
</div>
