@model CategoryFormViewModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>Edit category</h1>
        <p>Changes apply immediately to every course in this category.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <form method="post" asp-action="Edit" asp-route-id="@Model.Id" novalidate>
            <partial name="_CategoryForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Save changes</button>
                <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
