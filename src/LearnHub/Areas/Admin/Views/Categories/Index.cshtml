@model IReadOnlyList<CategoryListItem>
@{
    ViewData["Title"] = "Categories";
}

<div class="admin-page-header">
    <div>
        <h1>Categories</h1>
        <p>Categories group courses in the catalogue. Each category has its own line colour on the website.</p>
    </div>
    <div class="admin-actions">
        <a class="btn btn-primary" asp-action="Create"><i class="bi bi-plus-lg" aria-hidden="true"></i>New category</a>
    </div>
</div>

@if (Model.Count == 0)
{
    <div class="empty-state">
        <span class="empty-icon" aria-hidden="true"><i class="bi bi-diagram-3"></i></span>
        <h2>No categories yet</h2>
        <p>Create a category before adding your first course.</p>
        <a class="btn btn-primary" asp-action="Create">Create a category</a>
    </div>
}
else
{
    <div class="table-wrap">
        <table class="table table-lh table-hover admin-table table-stack">
            <caption class="visually-hidden">Course categories</caption>
            <thead>
                <tr>
                    <th scope="col">Category</th>
                    <th scope="col" class="num">Published courses</th>
                    <th scope="col" class="num">All courses</th>
                    <th scope="col">Updated</th>
                    <th scope="col"><span class="visually-hidden">Actions</span></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var category in Model)
                {
                    <tr class="@DisplayFormat.LineClass(category.Id)">
                        <td class="cell-primary">
                            <span class="d-flex align-items-start gap-2">
                                <span class="line-chip p-0 border-0 bg-transparent"><span class="line-dot" aria-hidden="true"><i class="@("bi bi-" + category.IconName)"></i></span></span>
                                <span>
                                    <span class="cell-title">@category.Name</span>
                                    <span class="cell-sub">@(category.Description ?? "No description")</span>
                                </span>
                            </span>
                        </td>
                        <td class="num" data-label="Published courses">@category.PublishedCourseCount</td>
                        <td class="num" data-label="All courses"><a asp-controller="Courses" asp-action="Index" asp-route-categoryId="@category.Id">@category.CourseCount</a></td>
                        <td data-label="Updated"><time data-local datetime="@DisplayFormat.IsoDate(category.UpdatedAt)">@DisplayFormat.Date(category.UpdatedAt)</time></td>
                        <td class="cell-actions">
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@category.Id">Edit<span class="visually-hidden"> @category.Name</span></a>
                            <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@category.Id">Delete<span class="visually-hidden"> @category.Name</span></a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
