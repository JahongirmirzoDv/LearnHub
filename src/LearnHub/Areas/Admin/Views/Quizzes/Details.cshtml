@model AdminQuizDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
    </ol>
</nav>

<div class="admin-page-header">
    <div>
        <h1>@Model.Title</h1>
        <p>
            @if (!Model.IsPublished)
            {
                <span class="badge-state badge-state--draft me-2">Draft</span>
            }
            else if (Model.Questions.Count == 0)
            {
                <span class="badge-state badge-state--warn me-2">Published, hidden until it has questions</span>
            }
            else
            {
                <span class="badge-state badge-state--live me-2">Published</span>
            }
            @(Model.Description ?? "No description")
        </p>
    </div>
    <div class="admin-actions">
        <form method="post" asp-action="SetPublished" asp-route-id="@Model.Id">
            <input type="hidden" name="isPublished" value="@(Model.IsPublished ? "false" : "true")" />
            <button type="submit" class="btn btn-outline-primary">@(Model.IsPublished ? "Unpublish" : "Publish")</button>
        </form>
        <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.Id"><i class="bi bi-pencil" aria-hidden="true"></i>Edit details</a>
        <a class="btn btn-outline-danger" asp-action="Delete" asp-route-id="@Model.Id"><i class="bi bi-trash" aria-hidden="true"></i>Delete</a>
        <a class="btn btn-primary" asp-controller="Questions" asp-action="Create" asp-route-quizId="@Model.Id"><i class="bi bi-plus-lg" aria-hidden="true"></i>Add question</a>
    </div>
</div>

<dl class="stat-strip quiz-stats">
    <div><dt>Questions</dt><dd>@Model.Questions.Count</dd></div>
    <div><dt>Pass mark</dt><dd>@Model.PassMarkPercent%</dd></div>
    <div><dt>Attempts</dt><dd><a class="text-reset" asp-controller="QuizAttempts" asp-action="Index" asp-route-quizId="@Model.Id">@Model.AttemptCount</a></dd></div>
    <div><dt>Average score</dt><dd>@(Model.AverageScorePercent is int average ? $"{average}%" : "–")</dd></div>
</dl>

@if (Model.Questions.Count == 0)
{
    <div class="empty-state">
        <span class="empty-icon" aria-hidden="true"><i class="bi bi-question-lg"></i></span>
        <h2>This quiz has no questions yet</h2>
        <p>Add at least one question with two or more answers, then publish the quiz.</p>
        <a class="btn btn-primary" asp-controller="Questions" asp-action="Create" asp-route-quizId="@Model.Id">Add the first question</a>
    </div>
}
else
{
    <h2 class="h5 mb-3">Questions in order</h2>
    <ol class="question-list">
        @foreach (var question in Model.Questions)
        {
            <li class="question-item">
                <header>
                    <div>
                        <p class="text-muted-lh small mb-1">Order @question.SortOrder, answered in @DisplayFormat.Plural(question.AnswerCount, "attempt")</p>
                        <h3>@question.Text</h3>
                    </div>
                    <div class="d-flex gap-2">
                        <a class="btn btn-sm btn-outline-primary" asp-controller="Questions" asp-action="Edit" asp-route-id="@question.Id">Edit<span class="visually-hidden"> question</span></a>
                        <a class="btn btn-sm btn-outline-danger" asp-controller="Questions" asp-action="Delete" asp-route-id="@question.Id">Delete<span class="visually-hidden"> question</span></a>
                    </div>
                </header>
                <ol type="A">
                    @foreach (var option in question.Options)
                    {
                        <li class="@(option.IsCorrect ? "is-correct" : null)">
                            @option.Text
                            @if (option.IsCorrect)
                            {
                                <i class="bi bi-check-circle-fill ms-1" aria-hidden="true"></i><span class="visually-hidden">(correct answer)</span>
                            }
                        </li>
                    }
                </ol>
                @if (!string.IsNullOrWhiteSpace(question.Explanation))
                {
                    <p class="review-explanation mb-0"><strong>Explanation:</strong> @question.Explanation</p>
                }
            </li>
        }
    </ol>
}
