@model QuizDeleteViewModel
@{
    ViewData["Title"] = $"Delete {Model.Title}";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Quizzes</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.Id">@Model.Title</a></li>
        <li class="breadcrumb-item active" aria-current="page">Delete</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>Delete quiz</h1>
        <p>@Model.Title, in @Model.CourseTitle</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-7">
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="danger-panel">
            <h2>Permanently delete this quiz?</h2>
            <p>The questions and every student attempt are deleted with it. This can't be undone.</p>
            <ul class="impact-list">
                <li><span>Questions and answer options</span><strong>@Model.QuestionCount</strong></li>
                <li><span>Student attempts</span><strong>@Model.AttemptCount</strong></li>
            </ul>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Delete quiz</button>
                <a class="btn btn-outline-primary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
            </div>
        </form>
    </div>
</div>
