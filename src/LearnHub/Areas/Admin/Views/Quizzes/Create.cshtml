@model QuizFormViewModel
@{
    ViewData["Title"] = "New quiz";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Quizzes</a></li>
        <li class="breadcrumb-item active" aria-current="page">New quiz</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>New quiz</h1>
        <p>The quiz is saved as a draft. Add questions next, then publish it.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-8">
        <form method="post" asp-action="Create" novalidate>
            <partial name="_QuizForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Create quiz</button>
                <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
