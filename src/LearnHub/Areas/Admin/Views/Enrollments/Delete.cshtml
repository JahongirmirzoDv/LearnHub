@model EnrollmentDeleteViewModel
@{
    ViewData["Title"] = "Remove enrolment";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Enrolments</a></li>
        <li class="breadcrumb-item active" aria-current="page">Remove</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>Remove enrolment</h1>
        <p>@Model.StudentName in @Model.CourseTitle</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-7">
        <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="danger-panel">
            <h2>Remove @Model.StudentName from this course?</h2>
            <p>
                @Model.StudentName (@Model.StudentEmail) enrolled in “@Model.CourseTitle” on
                <time data-local datetime="@DisplayFormat.IsoDate(Model.EnrolledAt)">@DisplayFormat.Date(Model.EnrolledAt)</time>.
                They lose access to the course lessons and quizzes. Their completed lessons and quiz attempts are kept, so progress returns if they enrol again.
            </p>
            <div class="form-actions">
                <button type="submit" class="btn btn-danger">Remove enrolment</button>
                <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
            </div>
        </form>
    </div>
</div>
