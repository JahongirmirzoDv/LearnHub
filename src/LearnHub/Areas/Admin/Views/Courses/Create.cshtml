@model CourseFormViewModel
@{
    ViewData["Title"] = "New course";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Courses</a></li>
        <li class="breadcrumb-item active" aria-current="page">New course</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>New course</h1>
        <p>Save the course first, then add learning resources and a quiz.</p>
    </div>
</div>

@if (Model.CategoryOptions.Count == 0)
{
    <div class="status-message status-warning" role="alert">
        <i class="bi bi-exclamation-triangle" aria-hidden="true"></i>
        <p>Every course needs a category. <a asp-controller="Categories" asp-action="Create">Create a category</a> first.</p>
    </div>
}

<form method="post" asp-action="Create" enctype="multipart/form-data" novalidate>
    <partial name="_CourseForm" model="Model" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Create course</button>
        <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
