@model QuestionFormViewModel
@{
    ViewData["Title"] = "New question";
}

<nav aria-label="Breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Quizzes" asp-action="Index">Quizzes</a></li>
        <li class="breadcrumb-item"><a asp-controller="Quizzes" asp-action="Details" asp-route-id="@Model.QuizId">@Model.QuizTitle</a></li>
        <li class="breadcrumb-item active" aria-current="page">New question</li>
    </ol>
</nav>
<div class="admin-page-header">
    <div>
        <h1>New question</h1>
        <p>Single-choice question for “@Model.QuizTitle”.</p>
    </div>
</div>

<div class="row">
    <div class="col-xl-9">
        <form method="post" asp-action="Create" novalidate>
            <partial name="_QuestionForm" model="Model" />
            <div class="form-actions">
                <button type="submit" class="btn btn-primary">Add question</button>
                <a class="btn btn-outline-primary" asp-controller="Quizzes" asp-action="Details" asp-route-id="@Model.QuizId">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
