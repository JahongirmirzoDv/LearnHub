@model ChangePasswordViewModel
@{
    ViewData["Title"] = "Change password";
}

<section class="page-header">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-action="Index">Profile</a></li>
                <li class="breadcrumb-item active" aria-current="page">Change password</li>
            </ol>
        </nav>
        <h1>Change password</h1>
        <p>Choose a new password you don't use on any other website.</p>
    </div>
</section>

<div class="page-body">
    <div class="container">
        <div class="row">
            <div class="col-lg-7">
                <form method="post" asp-action="ChangePassword" class="form-panel" novalidate>
                    <div asp-validation-summary="ModelOnly" class="validation-summary-errors" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="CurrentPassword" class="form-label"></label>
                        <input asp-for="CurrentPassword" class="form-control" autocomplete="current-password" />
                        <span asp-validation-for="CurrentPassword"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="NewPassword" class="form-label"></label>
                        <input asp-for="NewPassword" class="form-control" autocomplete="new-password" data-password-meter="new-password-meter" aria-describedby="new-password-help" />
                        <div class="password-meter" id="new-password-meter" data-score="0" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
                        <div class="form-text" aria-live="polite"></div>
                        <div id="new-password-help" class="form-text field-hint">@PasswordRules.Description</div>
                        <span asp-validation-for="NewPassword"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="ConfirmNewPassword" class="form-label"></label>
                        <input asp-for="ConfirmNewPassword" class="form-control" autocomplete="new-password" />
                        <span asp-validation-for="ConfirmNewPassword"></span>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <button type="submit" class="btn btn-primary">Change password</button>
                        <a class="btn btn-outline-primary" asp-action="Index">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
