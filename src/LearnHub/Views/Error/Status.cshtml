@model ErrorViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="container error-page">
    <div>
        <span class="error-code" aria-hidden="true">@Model.StatusCode</span>
        <h1 class="h2 mt-3">@Model.Title</h1>
        <p>@Model.Message</p>
        @if (!string.IsNullOrEmpty(Model.RequestId))
        {
            <p class="small">Reference for support: <code>@Model.RequestId</code></p>
        }
        <div class="d-flex flex-wrap justify-content-center gap-2 mt-4">
            <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go to the home page</a>
            <a class="btn btn-outline-primary" asp-controller="Courses" asp-action="Index">Browse courses</a>
        </div>
    </div>
</div>
