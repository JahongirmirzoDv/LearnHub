@model PaginationViewModel
@{
    // Show the first page, the last page and two pages either side of the current one.
    // Variables avoid the name "page" because the page directive is reserved in Razor.
    var pageNumbers = Enumerable.Range(1, Model.TotalPages)
        .Where(number => number == 1 || number == Model.TotalPages || Math.Abs(number - Model.Page) <= 2)
        .ToList();
}
@if (Model.TotalPages > 1)
{
    <nav aria-label="Pages">
        <ul class="pagination flex-wrap">
            <li class="page-item @(Model.Page <= 1 ? "disabled" : null)">
                @if (Model.Page <= 1)
                {
                    <span class="page-link" aria-hidden="true"><i class="bi bi-chevron-left"></i></span>
                }
                else
                {
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.ForPage(Model.Page - 1)" aria-label="Previous page"><i class="bi bi-chevron-left" aria-hidden="true"></i></a>
                }
            </li>
            @for (var index = 0; index < pageNumbers.Count; index++)
            {
                var pageNumber = pageNumbers[index];
                if (index > 0 && pageNumber - pageNumbers[index - 1] > 1)
                {
                    <li class="page-item disabled"><span class="page-link">…</span></li>
                }

                if (pageNumber == Model.Page)
                {
                    <li class="page-item active"><span class="page-link" aria-current="page">@pageNumber</span></li>
                }
                else
                {
                    <li class="page-item"><a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.ForPage(pageNumber)">@pageNumber</a></li>
                }
            }
            <li class="page-item @(Model.Page >= Model.TotalPages ? "disabled" : null)">
                @if (Model.Page >= Model.TotalPages)
                {
                    <span class="page-link" aria-hidden="true"><i class="bi bi-chevron-right"></i></span>
                }
                else
                {
                    <a class="page-link" asp-action="@Model.Action" asp-all-route-data="Model.ForPage(Model.Page + 1)" aria-label="Next page"><i class="bi bi-chevron-right" aria-hidden="true"></i></a>
                }
            </li>
        </ul>
    </nav>
}
