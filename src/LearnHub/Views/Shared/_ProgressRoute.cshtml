@model CourseProgress
@{
    var state = Model.IsCompleted ? "is-complete" : Model.IsStarted ? null : "is-empty";
}
<div class="progress-route @state" role="progressbar" aria-label="Course progress"
     aria-valuemin="0" aria-valuemax="100" aria-valuenow="@Model.Percent">
    <span class="progress-route-fill @DisplayFormat.ProgressWidthClass(Model.Percent)"></span>
</div>
<div class="progress-caption">
    <span>@(Model.IsCompleted ? "Completed" : $"{Model.Percent}% complete")</span>
    <span>@Model.CompletedItems of @Model.TotalItems done</span>
</div>
