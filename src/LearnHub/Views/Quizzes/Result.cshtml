@model QuizResultViewModel
@{
    ViewData["Title"] = $"Result: {Model.QuizTitle}";
}

<section class="page-header">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Quizzes" asp-action="Index">Quizzes</a></li>
                <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.QuizTitle</li>
            </ol>
        </nav>
        @* Same column as the review below, so the actions line up with the result card. *@
        <div class="row">
            <div class="col-lg-9 d-flex flex-wrap align-items-end justify-content-between gap-3">
                <div>
                    <h1>@Model.QuizTitle</h1>
                    <p>Your result and an explanation for every question.</p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    @if (Model.CanRetake)
                    {
                        <a class="btn @(Model.Passed ? "btn-outline-primary" : "btn-signal")" asp-action="Take" asp-route-id="@Model.QuizId">Retake quiz</a>
                    }
                    <a class="btn btn-outline-primary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Back to course</a>
                </div>
            </div>
        </div>
    </div>
</section>

<div class="page-body">
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <partial name="_QuizReview" model="Model" />
            </div>
        </div>
    </div>
</div>
