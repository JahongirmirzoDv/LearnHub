@model TakeQuizViewModel
@{
    ViewData["Title"] = Model.Title;
}

<section class="page-header">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Student" asp-action="Dashboard">Dashboard</a></li>
                <li class="breadcrumb-item"><a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">@Model.CourseTitle</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>
        <h1>@Model.Title</h1>
        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <p>@Model.Description</p>
        }
        <ul class="meta-list mt-3">
            <li><i class="bi bi-patch-question" aria-hidden="true"></i>@DisplayFormat.Plural(Model.Questions.Count, "question")</li>
            <li><i class="bi bi-flag" aria-hidden="true"></i>Pass mark @Model.PassMarkPercent%</li>
            @if (Model.PreviousAttemptCount > 0)
            {
                <li><i class="bi bi-arrow-repeat" aria-hidden="true"></i>@DisplayFormat.Plural(Model.PreviousAttemptCount, "previous attempt"), best score @Model.BestScorePercent%</li>
            }
        </ul>
    </div>
</section>

<div class="page-body">
    <div class="container">
        <div class="row">
            <div class="col-lg-9">
                <form method="post" asp-action="Take" asp-route-id="@Model.QuizId" data-quiz>
                    <p class="text-muted-lh">Choose one answer for each question. Unanswered questions count as incorrect. You can retake the quiz as often as you like.</p>

                    @foreach (var question in Model.Questions)
                    {
                        <fieldset class="quiz-question" id="@("question-" + question.Id)" data-question>
                            <legend>
                                <span class="quiz-question-number">Question @question.Number of @Model.Questions.Count</span>
                                @question.Text
                            </legend>
                            <div class="quiz-options">
                                @foreach (var option in question.Options)
                                {
                                    var inputId = $"option-{option.Id}";
                                    <div class="quiz-option">
                                        <input type="radio" id="@inputId" name="@($"Answers[{question.Id}]")" value="@option.Id" />
                                        <label for="@inputId">@option.Text</label>
                                    </div>
                                }
                            </div>
                        </fieldset>
                    }

                    <div class="quiz-submit-bar">
                        <span class="quiz-counter" data-quiz-counter aria-live="polite">@Model.Questions.Count questions</span>
                        <div class="d-flex flex-wrap gap-2">
                            <a class="btn btn-outline-primary" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId">Cancel</a>
                            <button type="submit" class="btn btn-signal">Submit answers</button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
