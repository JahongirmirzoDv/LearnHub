@model CourseDetailsViewModel
@{
    ViewData["Title"] = Model.Title;
    ViewData["Description"] = Model.ShortDescription;
    var line = DisplayFormat.LineClass(Model.CategoryId);
    var outcomes = DisplayFormat.Lines(Model.LearningOutcomes);
    var detailsUrl = Url.Action("Details", new { id = Model.Id });
    var currentStopMarked = false;
}

<section class="course-hero @line">
    <div class="container">
        <nav aria-label="Breadcrumb">
            <ol class="breadcrumb">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Home</a></li>
                <li class="breadcrumb-item"><a asp-action="Index">Courses</a></li>
                <li class="breadcrumb-item"><a asp-action="Index" asp-route-categoryId="@Model.CategoryId">@Model.CategoryName</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <div class="course-hero-grid">
            <div>
                @if (!Model.IsPublished)
                {
                    <p class="mb-2"><span class="badge-state badge-state--draft"><i class="bi bi-eye-slash" aria-hidden="true"></i>Draft: only administrators can see this course</span></p>
                }
                <p class="course-line mb-2"><i class="@("bi bi-" + Model.CategoryIcon)" aria-hidden="true"></i>@Model.CategoryName</p>
                <h1>@Model.Title</h1>
                <p class="course-summary">@Model.ShortDescription</p>
                <ul class="meta-list mt-3">
                    <li><span class="@DisplayFormat.DifficultyBadgeClass(Model.Difficulty)">@Model.Difficulty</span></li>
                    <li><i class="bi bi-clock" aria-hidden="true"></i>@DisplayFormat.Duration(Model.DurationMinutes)</li>
                    <li><i class="bi bi-signpost-split" aria-hidden="true"></i>@DisplayFormat.Plural(Model.Resources.Count, "lesson")</li>
                    <li><i class="bi bi-patch-question" aria-hidden="true"></i>@DisplayFormat.Plural(Model.Quizzes.Count, "quiz", "quizzes")</li>
                    <li><i class="bi bi-people" aria-hidden="true"></i>@DisplayFormat.Plural(Model.EnrollmentCount, "learner")</li>
                </ul>
                <p class="mt-3 mb-0"><i class="bi bi-person-video3 me-1" aria-hidden="true"></i>Taught by <strong>@Model.InstructorName</strong></p>
            </div>
            <div class="course-hero-cover">
                <course-cover path="@Model.ThumbnailPath" icon="@Model.CategoryIcon" eager="true" />
            </div>
        </div>
    </div>
</section>

<div class="page-body">
    <div class="container course-layout">
        <div>
            <section class="mb-5" aria-labelledby="about-title">
                <h2 id="about-title" class="h3 mb-3">About this course</h2>
                <div class="prose">
                    @foreach (var paragraph in DisplayFormat.Paragraphs(Model.Description))
                    {
                        <p>@paragraph</p>
                    }
                </div>
            </section>

            @if (outcomes.Count > 0)
            {
                <section class="mb-5" aria-labelledby="outcomes-title">
                    <h2 id="outcomes-title" class="h3 mb-3">What you will learn</h2>
                    <ul class="outcome-list">
                        @foreach (var outcome in outcomes)
                        {
                            <li><i class="bi bi-check2-circle" aria-hidden="true"></i><span>@outcome</span></li>
                        }
                    </ul>
                </section>
            }

            <section class="@line" aria-labelledby="route-title">
                <div class="section-heading">
                    <div>
                        <h2 id="route-title" class="h3">Course route</h2>
                        <p>Lessons and quizzes in the recommended order.@(Model.CanAccessAllContent ? string.Empty : " Free preview lessons can be opened without enrolling.")</p>
                    </div>
                </div>

                @if (Model.Resources.Count == 0 && Model.Quizzes.Count == 0)
                {
                    <div class="empty-state">
                        <span class="empty-icon" aria-hidden="true"><i class="bi bi-hourglass-split"></i></span>
                        <h3>Lessons are being prepared</h3>
                        <p>The instructor has not added any lessons yet. Check back soon.</p>
                    </div>
                }
                else
                {
                    <ol class="route">
                        @foreach (var resource in Model.Resources)
                        {
                            var accessible = Model.CanAccessAllContent || resource.IsPreview;
                            var isCurrent = Model.IsEnrolled && !resource.IsCompleted && !currentStopMarked;
                            if (isCurrent)
                            {
                                currentStopMarked = true;
                            }
                            var state = resource.IsCompleted ? "is-done" : isCurrent ? "is-current" : accessible ? null : "is-locked";
                            <li class="route-stop @state">
                                <span class="route-marker" aria-hidden="true">
                                    @if (resource.IsCompleted)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else if (!accessible)
                                    {
                                        <i class="bi bi-lock-fill"></i>
                                    }
                                </span>
                                <div class="route-body">
                                    <div>
                                        @if (accessible)
                                        {
                                            <a class="route-title" asp-controller="Resources" asp-action="Details" asp-route-id="@resource.Id">@resource.Title</a>
                                        }
                                        else
                                        {
                                            <span class="route-title">@resource.Title</span>
                                        }
                                        @if (resource.IsCompleted)
                                        {
                                            <span class="visually-hidden">(completed)</span>
                                        }
                                        else if (isCurrent)
                                        {
                                            <span class="visually-hidden">(your next lesson)</span>
                                        }
                                        else if (!accessible)
                                        {
                                            <span class="visually-hidden">(enrol to open)</span>
                                        }
                                    </div>
                                    <span class="route-meta">
                                        <span><i class="bi @DisplayFormat.ResourceIcon(resource.Type)" aria-hidden="true"></i>@DisplayFormat.ResourceTypeName(resource.Type)</span>
                                        @if (resource.EstimatedMinutes is int minutes)
                                        {
                                            <span><i class="bi bi-clock" aria-hidden="true"></i>@DisplayFormat.Duration(minutes)</span>
                                        }
                                        @if (resource.IsPreview && !Model.CanAccessAllContent)
                                        {
                                            <span class="badge-state badge-state--info">Free preview</span>
                                        }
                                    </span>
                                </div>
                            </li>
                        }

                        @foreach (var quiz in Model.Quizzes)
                        {
                            var isCurrent = Model.IsEnrolled && !quiz.HasPassed && !currentStopMarked;
                            if (isCurrent)
                            {
                                currentStopMarked = true;
                            }
                            var state = quiz.HasPassed ? "is-done" : isCurrent ? "is-current" : Model.IsEnrolled ? null : "is-locked";
                            <li class="route-stop is-quiz @state">
                                <span class="route-marker" aria-hidden="true">
                                    @if (quiz.HasPassed)
                                    {
                                        <i class="bi bi-check-lg"></i>
                                    }
                                    else if (!Model.IsEnrolled)
                                    {
                                        <i class="bi bi-lock-fill"></i>
                                    }
                                </span>
                                <div class="route-body">
                                    <div>
                                        @if (Model.IsEnrolled)
                                        {
                                            <a class="route-title" asp-controller="Quizzes" asp-action="Take" asp-route-id="@quiz.Id">@quiz.Title</a>
                                        }
                                        else
                                        {
                                            <span class="route-title">@quiz.Title</span>
                                        }
                                        @if (quiz.HasPassed)
                                        {
                                            <span class="visually-hidden">(passed)</span>
                                        }
                                    </div>
                                    <span class="route-meta">
                                        <span><i class="bi bi-patch-question" aria-hidden="true"></i>Quiz with @DisplayFormat.Plural(quiz.QuestionCount, "question")</span>
                                        <span>Pass mark @quiz.PassMarkPercent%</span>
                                        @if (quiz.BestScorePercent is int best)
                                        {
                                            <span class="score-pill @(quiz.HasPassed ? "is-passed" : null)">Best @best%</span>
                                        }
                                    </span>
                                </div>
                            </li>
                        }
                    </ol>
                }
            </section>
        </div>

        <aside class="enrol-panel" aria-labelledby="enrol-title">
            @if (Model.IsAdminView)
            {
                <h2 id="enrol-title" class="h5">Administrator view</h2>
                <p class="text-muted-lh">You can open every lesson without enrolling. Students see this page with an enrol button.</p>
                <a class="btn btn-primary w-100" asp-area="Admin" asp-controller="Courses" asp-action="Details" asp-route-id="@Model.Id"><i class="bi bi-gear" aria-hidden="true"></i>Manage course</a>
            }
            else if (Model.IsEnrolled)
            {
                <h2 id="enrol-title" class="h5 mb-3">Your progress</h2>
                <partial name="_ProgressRoute" model="Model.Progress" />
                if (Model.NextResourceId is int nextId && !Model.Progress.IsCompleted)
                {
                    <a class="btn btn-signal w-100 mt-3" asp-controller="Resources" asp-action="Details" asp-route-id="@nextId">
                        @(Model.Progress.IsStarted ? "Continue learning" : "Start the first lesson")
                    </a>
                }
                else if (Model.Progress.IsCompleted)
                {
                    <p class="mt-3 mb-0 fw-bold text-success"><i class="bi bi-trophy me-1" aria-hidden="true"></i>You completed this course.</p>
                }
                if (Model.EnrolledAt is DateTime enrolledAt)
                {
                    <p class="small text-muted-lh mt-3 mb-1">Enrolled on <time data-local datetime="@DisplayFormat.IsoDate(enrolledAt)">@DisplayFormat.Date(enrolledAt)</time></p>
                }
                <form method="post" asp-action="Leave" asp-route-id="@Model.Id"
                      data-confirm="Leave this course? Your completed lessons are kept if you enrol again.">
                    <button type="submit" class="btn btn-link btn-sm p-0 text-danger">Leave this course</button>
                </form>
            }
            else if (User.IsStudent())
            {
                <h2 id="enrol-title" class="h5">Enrol in this course</h2>
                <p class="text-muted-lh">Free for students. Enrolling opens every lesson and quiz and starts tracking your progress.</p>
                <form method="post" asp-action="Enroll" asp-route-id="@Model.Id">
                    <button type="submit" class="btn btn-signal btn-lg w-100">Enrol for free</button>
                </form>
            }
            else
            {
                <h2 id="enrol-title" class="h5">Start learning</h2>
                <p class="text-muted-lh">Create a free student account to enrol, track your progress and take quizzes.</p>
                <a class="btn btn-signal btn-lg w-100" asp-controller="Account" asp-action="Register" asp-route-returnUrl="@detailsUrl">Create a free account</a>
                <a class="btn btn-outline-primary w-100 mt-2" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@detailsUrl">Log in to enrol</a>
            }

            <ul class="fact-list">
                <li><i class="bi bi-bar-chart" aria-hidden="true"></i>@Model.Difficulty level</li>
                <li><i class="bi bi-clock" aria-hidden="true"></i>About @DisplayFormat.Duration(Model.DurationMinutes)</li>
                <li><i class="bi bi-arrow-repeat" aria-hidden="true"></i>Updated <time data-local datetime="@DisplayFormat.IsoDate(Model.UpdatedAt)">@DisplayFormat.Date(Model.UpdatedAt)</time></li>
            </ul>
        </aside>
    </div>

    @if (Model.RelatedCourses.Count > 0)
    {
        <section class="container mt-5" aria-labelledby="related-title">
            <h2 id="related-title" class="h3 mb-3">More in @Model.CategoryName</h2>
            <div class="course-grid">
                @foreach (var course in Model.RelatedCourses)
                {
                    <partial name="_CourseCard" model="course" />
                }
            </div>
        </section>
    }
</div>
