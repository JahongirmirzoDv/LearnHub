{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Sqlite": "Data Source=App_Data/learnhub.db",
    "SqlServer": ""
  },
  "Database": {
    "Provider": "Sqlite",
    "ApplyMigrationsOnStartup": true
  },
  "Seed": {
    "DemoData": true,
    "AdminEmail": "admin@learnhub.local",
    "AdminFullName": "LearnHub Administrator",
    "AdminPassword": "",
    "DemoStudentEmail": "demo.student@example.com",
    "DemoStudentPassword": ""
  },
  "Storage": {
    "RootPath": "App_Data/storage",
    "MaxImageBytes": 2097152,
    "MaxDocumentBytes": 10485760
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Site": {
    "RepositoryUrl": "https://github.com/JahongirmirzoDv/LearnHub",
    "PresentationUrl": "https://jahongirmirzodv.github.io/LearnHub/"
  }
}
