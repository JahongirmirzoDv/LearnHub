{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=App_Data/learnhub.db"
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Seed": {
    "DemoData": true,
    "AdminEmail": "admin@learnhub.local",
    "AdminFullName": "LearnHub Administrator",
    "AdminPassword": "",
    "DemoStudentEmail": "demo.student@example.com",
    "DemoStudentPassword": ""
  },
  "Storage": {
    "RootPath": "App_Data/storage"
  },
  "RateLimiting": {
    "PermitLimit": 10,
    "WindowSeconds": 60
  },
  "Site": {
    "RepositoryUrl": "https://github.com/KhayitOff/LearnHub",
    "PresentationUrl": "https://learnhub-wapp.web.app"
  }
}
