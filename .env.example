# ---------------------------------------------------------------- LearnHub environment variables ----------------------------------------------------------------
# Copy to .env for local use, or paste the values into Railway -> your service -> Variables.
# NEVER commit the filled-in .env file: it holds the administrator password. Only placeholders belong in Git.
#
# On Railway, ASP.NET Core reads a variable such as Seed__AdminPassword from the double-underscore name directly,
# so no code change is needed to switch environments.

# --------------------------------------------------------------- runtime ---------------------------------------------------------------
# Production turns on the friendly error page, HSTS and the Secure cookie policy. Use Development locally.
ASPNETCORE_ENVIRONMENT=Production

# Railway sets PORT itself; the application reads it and listens on 0.0.0.0:<PORT>.
# Only set this when running the container somewhere that does not provide it.
PORT=8080

# --------------------------------------------------------------- database ---------------------------------------------------------------
# SQLite file. On Railway this must sit on the mounted volume, otherwise every redeploy starts from an empty
# database. Mount a volume at /data and keep the path below.
# Raising/setting this overrides ConnectionStrings:DefaultConnection from appsettings.json.
DATABASE_CONNECTION_STRING=Data Source=/data/learnhub.db

# Applies pending EF Core migrations at start-up. Leave true for the single-instance deployment used here.
Database__ApplyMigrationsOnStartup=true

# --------------------------------------------------------------- persistent state ---------------------------------------------------------------
# Identity cookies are encrypted with the Data Protection key ring: without a persistent location every restart
# signs everybody out. Uploads made by administrators live under the storage path for the same reason.
DataProtection__KeysPath=/data/keys
Storage__RootPath=/data/storage

# --------------------------------------------------------------- seed accounts ---------------------------------------------------------------
# DEMO ONLY. The administrator is created on the first start of an empty database. Set a strong password here
# (a secret store - not in Git) or no administrator will exist and nobody can reach the admin area.
Seed__AdminEmail=admin@learnhub.local
Seed__AdminFullName=LearnHub Administrator
Seed__AdminPassword=REPLACE-WITH-A-STRONG-PASSWORD

# The demonstration student and the extra learners make the dashboard and progress pages look realistic.
# They cannot sign in unless a password is set here.
Seed__DemoStudentEmail=demo.student@example.com
Seed__DemoStudentPassword=REPLACE-WITH-A-STRONG-PASSWORD

# Creates the demonstration catalogue (categories, courses, lessons, quizzes). Set to false for a clean install.
Seed__DemoData=true

# --------------------------------------------------------------- links shown in the footer ---------------------------------------------------------------
Site__RepositoryUrl=https://github.com/KhayitOff/LearnHub
Site__PresentationUrl=https://learnhub-wapp.web.app
